<?xml version="1.0" encoding="utf-8"?>
<!-- shimmer_home.xml - skeleton loading for home screen -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Banner Skeleton -->
    <View
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@color/shimmer_base"/>

    <!-- Section Title Skeleton -->
    <View
        android:layout_width="160dp"
        android:layout_height="16dp"
        android:background="@color/shimmer_base"
        android:layout_margin="16dp"/>

    <!-- Horizontal Cards Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp">

        <View android:layout_width="140dp" android:layout_height="200dp"
            android:layout_margin="4dp" android:background="@color/shimmer_base"/>
        <View android:layout_width="140dp" android:layout_height="200dp"
            android:layout_margin="4dp" android:background="@color/shimmer_base"/>
        <View android:layout_width="140dp" android:layout_height="200dp"
            android:layout_margin="4dp" android:background="@color/shimmer_base"/>
    </LinearLayout>

    <!-- Section Title 2 -->
    <View
        android:layout_width="120dp"
        android:layout_height="16dp"
        android:background="@color/shimmer_base"
        android:layout_margin="16dp"/>

    <!-- Stars Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp">

        <LinearLayout android:layout_width="80dp" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center" android:layout_margin="4dp">
            <View android:layout_width="64dp" android:layout_height="64dp"
                android:background="@color/shimmer_base"/>
            <View android:layout_width="60dp" android:layout_height="10dp"
                android:background="@color/shimmer_base" android:layout_marginTop="4dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="80dp" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center" android:layout_margin="4dp">
            <View android:layout_width="64dp" android:layout_height="64dp"
                android:background="@color/shimmer_base"/>
            <View android:layout_width="60dp" android:layout_height="10dp"
                android:background="@color/shimmer_base" android:layout_marginTop="4dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="80dp" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center" android:layout_margin="4dp">
            <View android:layout_width="64dp" android:layout_height="64dp"
                android:background="@color/shimmer_base"/>
            <View android:layout_width="60dp" android:layout_height="10dp"
                android:background="@color/shimmer_base" android:layout_marginTop="4dp"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
